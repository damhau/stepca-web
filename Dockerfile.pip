# Same image as Dockerfile, but installs dependencies with plain pip instead of uv.
# Build with: docker build -f Dockerfile.pip .  (or DOCKERFILE=Dockerfile.pip with docker compose)

# --- Frontend stage: the React app, built to static files ---
FROM node:22-slim AS frontend
WORKDIR /frontend
# Exact versions from package-lock.json
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build


# --- Build stage: install Python dependencies into a venv ---
FROM python:3.12-slim AS builder

# requirements.txt is exported from uv.lock with hashes, so pip installs the exact same versions
COPY requirements.txt .
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir --require-hashes -r requirements.txt


# --- Runtime stage ---
FROM python:3.12-slim

# Code lives in /app; runtime files (settings.json, jwk_key.json, admin.crt, admin.key, ca_root.crt,
# stepca-web.db, local_users.json) in the data directory /data
ENV PYTHONDONTWRITEBYTECODE=1 \
    DATA_DIR=/data \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app \
    GUNICORN_CMD_ARGS="--bind 0.0.0.0:5000 --workers 1 --threads 4 --access-logfile -"

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin app \
    && mkdir /data \
    && chown app:app /data

COPY --from=builder /opt/venv /opt/venv
COPY app /app/app
COPY --from=frontend /frontend/dist /app/frontend/dist

WORKDIR /data
USER app

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/healthz', timeout=4)"]

CMD ["gunicorn", "app:create_app()"]
