# Copy to .env and fill in. Env vars take precedence over settings.json.

# Flask session signing key (required, keep it stable across restarts)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# step-ca PostgreSQL database (the one configured in ca.json "db")
# Use host.docker.internal to reach a PostgreSQL running on the Docker host
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_USER=step-ca
DATABASE_PASSWORD=
DATABASE_NAME=step_ca_db
# A read-only role is enough (see README). The app's own data goes to SQLite:
# APP_DATABASE_URI=sqlite:////data/stepca-web.db

# step-ca. The CA_URL host must be one of the CA's DNS names (TLS is verified).
# For a CA on the Docker host, map that name in docker-compose.yml extra_hosts.
CA_URL=https://ca.example.com:9000
# Root fingerprint (required): step certificate fingerprint $(step path)/certs/root_ca.crt
CA_FINGERPRINT=
# Or give the root certificate itself instead of downloading it
# CA_ROOT=/data/root_ca.crt
# The app's own admin on the CA (see README, CA identity): this subject on this provisioner
CA_ADMIN_PROVISIONER_NAME=stepca-web
CA_ADMIN_SUBJECT=stepca-web
# The provisioner's password; docker-compose.yml sets it to the ca_admin_password secret
# CA_ADMIN_PASSWORD_FILE=/run/secrets/ca_admin_password

# Authentication backend: ldap (default), local, radius, saml, oidc
# "local" reads users from local_users.json (mount it in docker-compose.yml)
AUTH_BACKEND=ldap
LDAP_URL=ldap://ldap.example.com
LDAP_BASE_DN=dc=example,dc=com
# LDAP_DOMAIN=
# LDAP_USER_SEARCH_FILTER=(uid={username})
# LDAP_USER_SEARCH_BASE=
# LDAP_REQUIRED_GROUP_DN=

# Roles: viewer (read-only), operator (also sign and revoke), admin (also provisioners,
# admins, configuration, audit log). LDAP group DNs per role, highest match wins.
# Users in none of these groups get DEFAULT_ROLE: viewer (default), operator, admin, or none to refuse them.
# Local users set "role" in local_users.json instead.
# ROLE_ADMIN_GROUP=CN=PKI-Admins,OU=Groups,DC=example,DC=com
# ROLE_OPERATOR_GROUP=CN=PKI-Operators,OU=Groups,DC=example,DC=com
# ROLE_VIEWER_GROUP=
# DEFAULT_ROLE=viewer

# Sessions expire after this many hours
# SESSION_LIFETIME_HOURS=8

# Start/stop/restart of the step-ca systemd unit via sudo. Off by default; cannot work in Docker
# SERVICE_CONTROL_ENABLED=false

# Set to true when the UI is served over HTTPS (e.g. behind a TLS reverse proxy)
# SESSION_COOKIE_SECURE=true

# Image build: Dockerfile (uv, default) or Dockerfile.pip (plain pip)
# DOCKERFILE=Dockerfile.pip

# Published address and port of the UI
# STEPCA_WEB_BIND=127.0.0.1
# STEPCA_WEB_PORT=5000

# Override the image's gunicorn flags. Keep 1 worker: several workers race
# when they renew admin.crt/admin.key
# GUNICORN_CMD_ARGS=--bind 0.0.0.0:5000 --workers 1 --threads 4 --access-logfile -
